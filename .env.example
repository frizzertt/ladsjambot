# Telegram Bot API Token (obtain from @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Last.fm API Key & Shared Secret (obtain from https://www.last.fm/api/account/create)
LASTFM_API_KEY=YOUR_LASTFM_API_KEY
LASTFM_SHARED_SECRET=YOUR_LASTFM_SHARED_SECRET

# SQLite database path (optional, default: bot.db)
DB_PATH=bot.db

# Custom User-Agent for Last.fm API requests
USER_AGENT=NowPlayingTelegramBot/1.0 (+https://github.com/showwhatimlistening)
